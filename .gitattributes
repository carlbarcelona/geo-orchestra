# Normalize line endings: LF in the repository and working tree
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets (never diff or convert)
*.bin binary
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gz binary
*.ico binary

# Generated data: collapse in diffs
public/data/**/*.json linguist-generated=true -diff
package-lock.json -diff
