{
  "name": "geoorchestra-demo-video",
  "private": true,
  "description": "30-second Space Apps demo of GeoOrchestra: real app footage and audio captured with Playwright, edited in Remotion.",
  "scripts": {
    "capture": "node capture/capture.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Demo out/geoorchestra-demo.mp4 --codec=h264 --audio-codec=aac"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.543",
    "@remotion/media-utils": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "typescript": "^5.6.0"
  }
}
